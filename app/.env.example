# 复制为 app/.env 后填写。不要提交 .env，不要把真实 client_secret 写入仓库。
# KEMI 只证明身份（sub）。本模块角色在应用内授予。

PORT=3000
HOST=127.0.0.1
# 至少 16 字符。本地可用：openssl rand -hex 24
SESSION_SECRET=replace-with-local-random-string

# 开发者平台 Web 应用。未填写时服务可启动，但「KEMI 登录」会返回未配置。
KEMI_CLIENT_ID=
KEMI_CLIENT_SECRET=
KEMI_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
KEMI_UC_API=https://kemi.newlinksz.com/usercenter

# 仅本地骨架走查。生产必须保持 false。开启后可用种子用户建立会话，不是第二套账号体系。
ALLOW_DEV_LOGIN=false
SEED_DEMO_USERS=true

# 金额阈值占位：留空表示未配置。禁止在仓库里写业务金额。
# SZ 只用 THR_CNY_*，HK 只用 THR_HKD_*。两套矩阵结构相同，数字独立，互不继承。
# 低额 < THR_*_FIN；中额至 THR_*_CEO 以下；高额 >= THR_*_CEO。
# 低值易耗走简化低额矩阵（跳过财务/总经理），不另设第三套金额。
THR_CNY_FIN=
THR_CNY_CEO=
THR_HKD_FIN=
THR_HKD_CEO=
THR_CNY_RFQ=
THR_HKD_RFQ=
THR_CNY_CAPEX=
THR_HKD_CAPEX=

# 预付矩阵（阶段 2）。留空表示未配置，提交或审批时会拒绝，不套默认金额。
# D-P1 低额 < THR_*_PREPAY_FIN；中额至 THR_*_PREPAY_CEO 以下；高额 >= THR_*_PREPAY_CEO。
THR_CNY_PREPAY_FIN=
THR_CNY_PREPAY_CEO=
THR_HKD_PREPAY_FIN=
THR_HKD_PREPAY_CEO=
# 预付额达到该值时必须附合同（Q12）。
THR_CNY_PREPAY_CONTRACT=
THR_HKD_PREPAY_CONTRACT=
# 部分预付占 PO 的比例上限，例如 0.80。留空表示未配置。不超过 1。
PREPAY_RATIO_MAX=
# 仅 true 时允许预付额等于 PO，并强制走高额预付档（Q10）。默认 false。
ALLOW_FULL_PREPAY=false
# 仅 true 时，D-P1 改用请购矩阵 THR_*_FIN / THR_*_CEO（Q9）。默认 false。
PREPAY_INHERIT_PR_MATRIX=false
# ①-E1 已付未验收超期天数（Q11）。留空表示未配置，清单任务会拒绝，不套默认天数。
PREPAY_OVERDUE_DAYS=

# 路径②报销超额加签（D5）。低额 < THR_*_REIM 跳过 ②-7；达到该额必须加签。留空表示未配置。
# 事前申请强制是固定规则，没有开关。
THR_CNY_REIM=
THR_HKD_REIM=
