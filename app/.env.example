# 复制为 app/.env 后填写。不要提交 .env，不要把真实 client_secret 写入仓库。
# KEMI 只证明身份（sub）。本模块角色在应用内授予。

PORT=3000
HOST=127.0.0.1
# 至少 16 字符。本地可用：openssl rand -hex 24
SESSION_SECRET=replace-with-local-random-string

# 开发者平台 Web 应用。未填写时服务可启动，但「KEMI 登录」会返回未配置。
KEMI_CLIENT_ID=
KEMI_CLIENT_SECRET=
KEMI_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
KEMI_UC_API=https://kemi.newlinksz.com/usercenter

# 仅本地骨架走查。生产必须保持 false。开启后可用种子用户建立会话，不是第二套账号体系。
ALLOW_DEV_LOGIN=false
SEED_DEMO_USERS=true

# 金额阈值占位：留空表示未配置。禁止在仓库里写业务金额。
# 低额 < THR_*_FIN；中额至 THR_*_CEO 以下；高额 >= THR_*_CEO。
THR_CNY_FIN=
THR_CNY_CEO=
THR_HKD_FIN=
THR_HKD_CEO=
THR_CNY_RFQ=
THR_HKD_RFQ=
THR_CNY_CAPEX=
THR_HKD_CAPEX=
